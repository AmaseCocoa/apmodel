{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "apmodel schema",
  "type": "object",
  "properties": {
    "imports": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Python import path (e.g. ..core.object)" },
          "name": { "type": "string", "description": "Class name to import" }
        },
        "required": ["path", "name"]
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "extends": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "mixins": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "description": "Python type hint (e.g. str | Object)" },
                "description": { "type": "string" },
                "decode": { "type": "string", "description": "Python snippet for getter" },
                "encode": { "type": "string", "description": "Python snippet for setter" },
                "alias": { "type": ["string", "null"], "default": null }
              },
              "required": ["type"]
            }
          }
        }
      }
    }
  },
  "required": ["classes"]
}