from typing import TYPE_CHECKING, Annotated, Any, ClassVar, Dict, List, Literal, Optional, Union
from pydantic import Field, ConfigDict, TypeAdapter, model_serializer
from apmodel.base import AS2Model
from apmodel.wrapper import WrapAS2

{% for mixin in mixins | default([], true) %}
from apmodel.mixins.{{ mixin | mixin_to_file }} import {{ mixin }}
{% endfor %}
{% for imp in external_imports | default([], true) %}
from {{ imp.path }} import {{ imp.name }}
{% endfor %}

if TYPE_CHECKING:
    from apmodel.base import ZDateTime as datetime
    from apmodel.context import Context

{% for class_name, config in classes.items() %}
class {{ class_name }}({% for m in config.mixins | default([], true) %}{{ m }}, {% endfor %}{{ config.extends or 'AS2Model' }}):
    """
{{ config.description | default(class_name) }}
    """
    
    {% if config.isCoreType is not sameas true %}
    type: Literal["{{ class_name }}"] = "{{ class_name }}"
    {% endif %}

    
    {% if config.properties %}
    {% for prop_name, prop_conf in config.properties.items() %}
    {%- set python_name = prop_name | to_snake -%}
    {%- set field_args = ["kw_only=True"] -%}
    {%- if prop_conf.alias %}{% do field_args.append("alias='" ~ prop_conf.alias ~ "'") %}{% endif -%}
    {%- if prop_conf.default is defined %}{% do field_args.append("default=" ~ prop_conf.default) -%}
    {%- elif prop_conf.default_factory %}{% do field_args.append("default_factory=" ~ prop_conf.default_factory) -%}
    {%- if prop_conf.additionalFieldArgs -%}
        {%- for k, v in prop_conf.additionalFieldArgs.items() -%}
            {%- if v is string -%}
                {%- set val = "'" ~ v ~ "'" -%}
            {%- else -%}
                {%- set val = v -%}
            {%- endif -%}
            {%- do field_args.append(k ~ "=" ~ val) -%}
        {%- endfor -%}
    {%- endif -%}

    {%- else %}{% do field_args.append("default=None") %}{% endif -%}
    
    {% if prop_conf._rendered_field is defined -%}
    {{ python_name }}: {{ prop_conf.type }} = {{ prop_conf._rendered_field }}
    {%- elif not prop_conf.decode and not prop_conf.encode -%}
    {{ python_name }}: {{ prop_conf.type }} = Field({{ field_args | join(", ") }})
    {%- else -%}
    _{{ python_name }}: {{ prop_conf.type }} = Field({{ field_args | join(", ") }})
    {%- endif %}
    {% endfor %}
    {% endif %}

    {% if config.contextRules %}
    @model_serializer(mode='wrap', when_used='always')
    def _serialize_with_conditional_context(self, serializer: Any, info: Any) -> Any:  # noqa: ANN401
        from fnmatch import fnmatchcase
        from apmodel.context import Context
        
        result = serializer(self)
        
        existing_fields = {
            field_name
            for field_name in self.__class__.model_fields
            if getattr(self, field_name, None) is not None
        }
        if self.model_extra:
            existing_fields.update(
                field_name for field_name, value in self.model_extra.items() if value is not None
            )
        
        watched_fields = {{ config.contextRules.when_field_exists | default([]) }}
        context_data = {{ config.contextRules.context }}
        
        def field_matches() -> bool:
            if not watched_fields:
                return bool(existing_fields)
            return any(
                fnmatchcase(field_name, pattern)
                for field_name in existing_fields
                for pattern in watched_fields
            )
        
        if field_matches() and context_data:
            conditional = Context.parse(context_data)
            if self.ctx is None:
                self.ctx = conditional
            else:
                self.ctx = self.ctx + conditional
        
        return result
    {% endif %}
{% endfor %}
